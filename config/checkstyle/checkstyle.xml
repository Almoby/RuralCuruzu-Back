<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
    Warn-only lint guard (D4): the ONLY rule enabled is UnusedImports.
    Wired to run during the build without ever failing it — see the
    maven-checkstyle-plugin configuration in pom.xml
    (failOnViolation=false, failsOnError=false, violationSeverity=warning).
-->
<module name="Checker">
    <module name="TreeWalker">
        <module name="UnusedImports">
            <property name="severity" value="warning"/>
        </module>
    </module>
</module>
